# Private simulated bank service
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY fake-bank/pom.xml fake-bank/pom.xml
COPY fake-bank/src fake-bank/src
RUN mvn -B -f fake-bank/pom.xml -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/fake-bank/target/*.jar app.jar
EXPOSE 8081
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-jar", "/app/app.jar"]
